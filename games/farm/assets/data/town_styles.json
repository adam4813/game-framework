        "town":    [ { "material": "cobblestone", "weight": 70 }, { "material": "dirt", "weight": 15 }, { "material": "brick", "weight": 15 } ],
        "city":    [ { "material": "brick", "weight": 60 }, { "material": "cobblestone", "weight": 35 }, { "material": "dirt", "weight": 5 } ]
      }
    },
