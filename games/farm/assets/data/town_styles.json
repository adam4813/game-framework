        "town":    [ { "material": "cobblestone", "weight": 55 }, { "material": "moss", "weight": 25 }, { "material": "dirt", "weight": 20 } ],
        "city":    [ { "material": "cobblestone", "weight": 50 }, { "material": "brick", "weight": 35 }, { "material": "moss", "weight": 15 } ]
